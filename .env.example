# Numeric App ID from the GitHub App settings page.
GITHUB_APP_ID=
# Secret configured on the GitHub App's webhook, used to verify X-Hub-Signature-256.
GITHUB_WEBHOOK_SECRET=
# Path to the App's private key .pem file (set this OR GITHUB_PRIVATE_KEY).
GITHUB_PRIVATE_KEY_PATH=
# PEM contents of the private key on one line with literal \n (set this OR GITHUB_PRIVATE_KEY_PATH).
GITHUB_PRIVATE_KEY=
# SQLAlchemy async URL, e.g. postgresql+asyncpg://user:password@localhost:5432/pr_review_bot
DATABASE_URL=
# Base URL of the LLM HTTP API, e.g. https://api.example.com/v1
LLM_BASE_URL=
# API key for the LLM API.
LLM_API_KEY=
# Model name to request from the LLM API.
LLM_MODEL=
# Hidden HTML marker used to find and update the bot's own PR comment.
BOT_COMMENT_MARKER="<!-- pr-review-bot -->"
# Logging level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
